parameters:
    tmpDir: build/phpstan
    level: 5
    paths:
        - demo/
        - src/
        - tests/
    bootstrapFiles:
        - vendor/codeigniter4/framework/system/Test/bootstrap.php
    excludePaths:
        - demo/Views/*
        - src/Views/*
    ignoreErrors:
        - '#Method Tests\\Support\\DatabaseTestCase::printDatabaseSchema\(\) is unused#'
    universalObjectCratesClasses:
        - CodeIgniter\Entity
        - CodeIgniter\Entity\Entity
        - Faker\Generator
    scanDirectories:
        - vendor/codeigniter4/framework/system/Helpers
    dynamicConstantNames:
        - APP_NAMESPACE
        - CI_DEBUG
        - ENVIRONMENT