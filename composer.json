{
  "name": "dgvirtual/codeigniter4-meta-info",
  "description": "Codeigniter4 library enabling use of Entity-Attribute-Value style storage for additional fields of models.",
  "type": "library",
  "keywords": [
    "codeigniter",
    "codeigniter4",
    "bonfire",
    "EAV"
  ],
  "homepage": "https://github.com/dgvirtual/codeigniter4-meta-info",
  "license": "MIT",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "codeigniter4/devkit": "^1.3",
    "codeigniter4/framework": "^4.5"
  },
  "autoload": {
    "psr-4": {
      "Dgvirtual\\MetaInfo\\": "src/"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests",
      "Tests\\Support\\": "tests/_support",
      "Dgvirtual\\Demo\\": "demo"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**"
    ]
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "authors": [
    {
      "name": "Donatas Glodenis",
      "email": "dg@lapas.info"
    }
  ],
  "scripts": {
    "test": [
      "vendor/bin/phpunit"
    ],
    "style": "vendor/bin/php-cs-fixer fix --dry-run",
    "style-fix": "vendor/bin/php-cs-fixer fix"
  }
}